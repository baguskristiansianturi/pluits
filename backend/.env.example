# PLUITS self-hosted backend. Replace every placeholder on the PLUITS-controlled host.
POSTGRES_DB=pluits
POSTGRES_USER=pluits
# Generate URL-safe password: openssl rand -hex 24
POSTGRES_PASSWORD=replace_with_48_hex_characters

# Generate independent keys: openssl rand -base64 32
PLUITS_OUTBOX_ENCRYPTION_KEY=replace_with_base64_32_byte_key
PLUITS_OUTBOX_KEY_VERSION=1
PLUITS_RATE_LIMIT_KEY=replace_with_a_different_base64_32_byte_key

# API domain must resolve to the host's public IP; Caddy obtains and renews HTTPS certificates.
PLUITS_API_DOMAIN=api.pluits.example
PLUITS_TLS_CONTACT_EMAIL=ops@example
PLUITS_ALLOWED_ORIGINS=https://baguskristiansianturi.github.io
PLUITS_PUBLIC_BASE_URL=https://baguskristiansianturi.github.io/pluits

# SMTP STARTTLS credentials for transactional verification and password-reset email.
PLUITS_SMTP_HOST=smtp.example
PLUITS_SMTP_PORT=587
PLUITS_SMTP_FROM=no-reply@example
PLUITS_SMTP_USERNAME=replace_me
PLUITS_SMTP_PASSWORD=replace_me

# Generate a backup keypair with: age-keygen -o pluits-backup-key.txt
# Store the private key offline; configure only the matching public recipient here.
PLUITS_BACKUP_AGE_RECIPIENT=age1replace_with_the_public_recipient
PLUITS_BACKUP_INTERVAL_SECONDS=86400
PLUITS_BACKUP_RETENTION_DAYS=14
