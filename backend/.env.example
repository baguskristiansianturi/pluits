# Copy to .env and replace every placeholder before starting any service.
POSTGRES_DB=pluits
POSTGRES_USER=pluits
# Use only URL-safe hexadecimal characters because this value is embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace_with_a_random_48_character_hex_value

# Generate each independent key with: openssl rand -base64 32
PLUITS_OUTBOX_ENCRYPTION_KEY=replace_with_base64_32_byte_key
PLUITS_OUTBOX_KEY_VERSION=1
PLUITS_RATE_LIMIT_KEY=replace_with_a_different_base64_32_byte_key

# Use the exact browser origin, not a wildcard. Add localhost only for local frontend development.
PLUITS_ALLOWED_ORIGINS=https://baguskristiansianturi.github.io
PLUITS_PUBLIC_BASE_URL=https://baguskristiansianturi.github.io/pluits

# SMTP STARTTLS provider credentials. Never commit the real .env file.
PLUITS_SMTP_HOST=smtp.example.com
PLUITS_SMTP_PORT=587
PLUITS_SMTP_FROM=no-reply@example.com
PLUITS_SMTP_USERNAME=replace_me
PLUITS_SMTP_PASSWORD=replace_me

# API is bound to loopback for a local reverse proxy; do not expose plaintext HTTP publicly.
PLUITS_API_LOCAL_PORT=8080
