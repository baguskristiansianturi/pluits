{
  email {$PLUITS_TLS_CONTACT_EMAIL}
  admin off
}

{$PLUITS_API_DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }

  reverse_proxy api:8080 {
    health_uri /health/ready
    health_interval 30s
    health_timeout 5s
  }
}
